# Example systemd service for Gunicorn running the Flask app
# Copy this to /etc/systemd/system/karbon.service and edit the paths/env values.

[Unit]
Description=Karbon Ayak Izi Flask App
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/path/to/your/project
Environment="FLASK_SECRET_KEY=replace-with-your-secret"
Environment="SMTP_SERVER=smtp.example.com"
Environment="SMTP_PORT=587"
Environment="SMTP_USERNAME=your-smtp-user"
Environment="SMTP_PASSWORD=your-smtp-password"
Environment="SMTP_FROM=you@example.com"
ExecStart=/path/to/your/project/.venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 app:app
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
